{
  "schemaVersion": "v6",
  "image": "",
  "generateName": true,
  "tags": [
    {
      "key": "tag",
      "value": "sglang"
    },
    {
      "key": "tag",
      "value": "llm"
    },
    {
      "key": "tag",
      "value": "inference"
    },
    {
      "key": "tag",
      "value": "gpu"
    },
    {
      "key": "tag",
      "value": "metrics"
    }
  ],
  "spec": {
    "display": {
      "name": "SGLang",
      "description": "SGLang inference server health from the native sglang:* metrics. Covers token throughput, time to first token, inter-token and end-to-end latency, queue depth, KV cache pool usage, and prefix cache hit rate."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "model_name",
            "description": "Filter panels to one model served by this SGLang server."
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "model_name",
              "signal": "metrics"
            }
          },
          "name": "model_name"
        }
      }
    ],
    "panels": {
      "ts_gen_throughput": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Generation Throughput (tokens/s)",
            "description": "Tokens generated per second, read from the sglang:gen_throughput gauge. SGLang reports this as a token/s rate, so the panel does not apply rate() on top of it. The engine samples it at its log interval, so it reads 0 while the server sits idle."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "sglang:gen_throughput",
                        "temporality": "unspecified",
                        "timeAggregation": "avg",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "model_name IN $model_name AND tp_rank = '0'"
                    },
                    "groupBy": [
                      {
                        "name": "model_name",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "having": {
                      "expression": ""
                    },
                    "legend": "{{model_name}}",
                    "limit": 100,
                    "order": [
                      {
                        "key": {
                          "name": "__result"
                        },
                        "direction": "desc"
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "ts_token_rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Prompt vs Generation Token Rate (tokens/s)",
            "description": "Prefill (prompt) against decode (generation) tokens per second, computed from the cumulative counters. Use this panel for the balance between input and output tokens, which drives cost. Use Generation Throughput for the instantaneous decode rate. The decode series here is the same quantity, smoothed by the rate window."

      "kpi-failure-rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "PostToolUseFailure / (PostToolUse + PostToolUseFailure). Counting has_error instead would inflate this roughly 2x.",
            "name": "Tool Failure Rate"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "2",
                "unit": "percentunit"
              },
              "thresholds": [
                {
                  "color": "#e5484d",
                  "format": "text",
                  "operator": "above",
                  "unit": "",
                  "value": 0.1
                }
              ],
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "failure_rate",
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "service.name = 'ide-agent' AND gen_ai.client.hook.event = 'PostToolUseFailure' AND gen_ai.client.name IN $agent AND vcs.repository.name IN $repo"
                          },
                          "functions": null,
                          "groupBy": null,
                          "legend": "",
                          "limit": 10000,
                          "name": "A",
                          "order": [
                            {
                              "direction": "desc",
                              "key": {
                                "fieldContext": "",
                                "fieldDataType": "",
                                "name": "count()",
                                "signal": ""
                              }
                            }
                          ],
                          "secondaryAggregations": null,
                          "selectFields": null,
                          "signal": "traces",
                          "source": "",
                          "stepInterval": 0
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "service.name = 'ide-agent' AND gen_ai.client.hook.event = 'PostToolUse' AND gen_ai.client.name IN $agent AND vcs.repository.name IN $repo"
                          },
                          "functions": null,
                          "groupBy": null,
                          "legend": "",
                          "limit": 10000,
                          "name": "B",
                          "order": [
                            {
                              "direction": "desc",
                              "key": {
                                "fieldContext": "",
                                "fieldDataType": "",
                                "name": "count()",
                                "signal": ""
                              }
                            }
                          ],
                          "secondaryAggregations": null,
                          "selectFields": null,
                          "signal": "traces",
                          "source": "",
                          "stepInterval": 0
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "disabled": false,
                          "expression": "A / (A + B)",
                          "functions": null,
                          "legend": "Failure Rate",
                          "limit": 100,
                          "name": "F1",
                          "order": [
                            {
                              "direction": "desc",
                              "key": {
                                "fieldContext": "",
                                "fieldDataType": "",
                                "name": "__result",
                                "signal": ""
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },

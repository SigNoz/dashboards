      "requests-by-model": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Share of model requests per model, counted from PostInvocation hook spans (one per pass of the agent loop), not from turns: a single turn commonly issues four or more model requests. Note that gen_ai.request.model reports what Antigravity actually used, which is not always what was asked for: requesting gemini-3.1-pro-high surfaces here as the internal id gemini-pro-agent.",
            "name": "Requests by Model"
          },
          "links": null,
          "plugin": {
            "kind": "signoz/PieChartPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "2",

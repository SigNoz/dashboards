  "spec": {
    "display": {
      "name": "Grok Build (Grok CLI)",
      "description": "Usage and health for xAI's Grok Build terminal coding agent, from its native OpenTelemetry export. Covers token consumption by type and model, session and turn volume, tool activity and outcomes, error categories, and startup latency broken down by phase. Requires GROK_EXTERNAL_OTEL=1 plus an OTLP exporter; note that grok 1.0.3 only exports successfully over http/protobuf, not grpc."
    },
    "variables": [],
    "panels": {
      "errors-by-category": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Errors by Category",
            "description": "Error categories over time. rate_limit covers both the per-minute ceiling and quota exhaustion, so use the api_error event's status_code to tell them apart."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "0"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "grok_code.error.count",
                        "temporality": "delta",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "groupBy": [
                      {
                        "name": "error_category",
                        "signal": "metrics",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [
                      {
                        "key": {
                          "name": "sum(increase(grok_code.error.count))",
                          "signal": "",
                          "fieldContext": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "limit": 100,
                    "legend": "{{error_category}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },

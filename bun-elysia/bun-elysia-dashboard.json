                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "signal": "traces",
                          "name": "A",
                          "aggregations": [
                            {
                              "expression": "p50(duration_nano)"
                            }
                          ],
                          "filter": {
                            "expression": "service.name IN $service_name AND deployment.environment.name IN $environment AND http.route IN $http_route AND http.route EXISTS"
                          },
                          "order": [
                            {
                              "key": {
                                "name": "p50(duration_nano)"
                              },
                              "direction": "desc"
                            }
                          ],
                          "limit": 100,
                          "legend": "P50"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "signal": "traces",
                          "name": "B",
                          "aggregations": [
                            {
                              "expression": "p95(duration_nano)"
                            }
                          ],
                          "filter": {
                            "expression": "service.name IN $service_name AND deployment.environment.name IN $environment AND http.route IN $http_route AND http.route EXISTS"
                          },
                          "order": [
                            {
                              "key": {
                                "name": "p95(duration_nano)"
                              },
                              "direction": "desc"
                            }
                          ],
                          "limit": 100,
                          "legend": "P95"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "signal": "traces",
                          "name": "C",
                          "aggregations": [
                            {
                              "expression": "p99(duration_nano)"
                            }
                          ],
                          "filter": {
                            "expression": "service.name IN $service_name AND deployment.environment.name IN $environment AND http.route IN $http_route AND http.route EXISTS"
                          },
                          "order": [
                            {
                              "key": {
                                "name": "p99(duration_nano)"
                              },
                              "direction": "desc"
                            }
                          ],
                          "limit": 100,
                          "legend": "P99"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },

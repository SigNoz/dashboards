                              "timeAggregation": "avg",
                              "spaceAggregation": "avg"
                            }
                          ],
                          "filter": {
                            "expression": "service.name IN $service_name AND deployment.environment.name IN $environment"
                          },
                          "order": [
                            {
                              "key": {
                                "name": "avg(avg(nodejs.eventloop.delay.p90))"
                              },
                              "direction": "desc"
                            }
                          ],
                          "limit": 100,
                          "legend": "P90"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "signal": "metrics",
                          "name": "C",
                          "aggregations": [
                            {
                              "metricName": "nodejs.eventloop.delay.p99",
                              "temporality": "unspecified",
                              "timeAggregation": "avg",
                              "spaceAggregation": "avg"
                            }

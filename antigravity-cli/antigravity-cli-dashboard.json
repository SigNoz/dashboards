  "spec": {
    "display": {
      "description": "Usage and spend for Google's Antigravity CLI (agy), from a hook-based OpenTelemetry exporter registered in Antigravity's own hooks system, since agy has no native OTLP export. Covers weekly Gemini quota burn-down, tool and agent-loop activity, model mix, and how turns ended. Every trace panel filters on agy.hook.event so the optional scripted wrapper does not double count tool calls, and quota panels are scoped to the gemini-weekly bucket, which Antigravity meters separately from the 3p-weekly bucket covering its Claude and GPT-OSS models.",
      "name": "Antigravity CLI"
    },
    "duration": "",

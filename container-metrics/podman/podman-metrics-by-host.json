      "cpu-cores-system": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "System CPU Cores Used",
            "description": "Rate of container.cpu.usage.system, the kernel-mode share of the container's CPU time. A high ratio against CPU Cores Used points at syscall or I/O pressure. The receiver truncates this counter to whole seconds, so it reads a flat zero until a container accumulates a full second of kernel time."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": { "legend": { "position": "bottom" } }
          },
          "queries": [

    "links": null,
    "panels": {
      "conversations": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Distinct interactive conversations seen in the selected window, counted from gen_ai.conversation.id across all hook spans.",
            "name": "Conversations"
          },
          "links": null,
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "2",
                "unit": ""
              },
              "thresholds": null,
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "aggregations": [
                      {
                        "alias": "Conversations",
                        "expression": "count_distinct(gen_ai.conversation.id)"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service_name AND agy.hook.event EXISTS"
                    },
                    "legend": "",
                    "limit": 100,
                    "name": "A",
                    "order": [
                      {
                        "direction": "desc",
                        "key": {
                          "fieldContext": "",
                          "fieldDataType": "",
                          "name": "count_distinct(gen_ai.conversation.id)",
                          "signal": ""
                        }
                      }
                    ],
                    "signal": "traces",
                    "source": ""
                  }
                }
              }
            }
          ]
        }
      },
      "loop-invocations": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "PostInvocation fires once per pass of the agent loop, not once per prompt. A single turn commonly produces six or more. Sustained growth here is the runaway-loop signal.",
            "name": "Agent Loop Invocations"
          },
          "links": null,
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": null,
                "softMin": null
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": ""
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service_name AND agy.hook.event = 'PostInvocation'"
                    },
                    "legend": "Loop invocations",
                    "limit": 100,
                    "name": "A",
                    "order": [
                      {
                        "direction": "desc",
                        "key": {
                          "fieldContext": "",
                          "fieldDataType": "",
                          "name": "count()",
                          "signal": ""
                        }
                      }
                    ],
                    "signal": "traces",
                    "source": ""
                  }
                }
              }
            }
          ]
        }
      },
      "quota-burn": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Fraction of the weekly Gemini limit still available, sampled at the end of each turn. The slope is the burn rate; Antigravity consumes quota proportionally to token cost. Scoped to the gemini-weekly bucket.",
            "name": "Gemini Quota Remaining"
          },
          "links": null,
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 1,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "percentunit"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "aggregations": [
                      {
                        "metricName": "agy.quota.remaining_fraction",
                        "spaceAggregation": "max",
                        "temporality": "",
                        "timeAggregation": "latest"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service_name AND agy.quota.bucket = 'gemini-weekly'"
                    },
                    "groupBy": [
                      {
                        "fieldContext": "attribute",
                        "fieldDataType": "string",
                        "name": "agy.quota.group",
                        "signal": "metrics"
                      }
                    ],
                    "legend": "{{agy.quota.group}}",
                    "limit": 100,
                    "name": "A",
                    "order": [
                      {
                        "direction": "desc",
                        "key": {
                          "fieldContext": "",
                          "fieldDataType": "",
                          "name": "__result",
                          "signal": ""
                        }
                      }
                    ],
                    "signal": "metrics",
                    "source": ""
                  }
                }
              }
            }
          ]
        }
      },
      "quota-current": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Latest remaining fraction for the Gemini weekly bucket. Antigravity meters Gemini models separately from Claude/GPT-OSS; only the Gemini bucket is shown here.",
            "name": "Current Gemini Quota"
          },
          "links": null,
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "formatting": {
                "columnUnits": {
                  "A": "percentunit",
                  "__result_0": "percentunit"
                },
                "decimalPrecision": "1"
              },
              "thresholds": null,
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "aggregations": [
                      {
                        "metricName": "agy.quota.remaining_fraction",
                        "reduceTo": "last",
                        "spaceAggregation": "max",
                        "temporality": "",
                        "timeAggregation": "latest"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service_name AND agy.quota.bucket = 'gemini-weekly'"
                    },
                    "groupBy": [
                      {
                        "fieldContext": "attribute",
                        "fieldDataType": "string",
                        "name": "agy.quota.bucket",
                        "signal": "metrics"
                      },
                      {
                        "fieldContext": "attribute",
                        "fieldDataType": "string",
                        "name": "agy.quota.group",
                        "signal": "metrics"
                      }
                    ],
                    "legend": "",
                    "limit": 100,
                    "name": "A",
                    "order": [
                      {
                        "direction": "desc",
                        "key": {
                          "fieldContext": "",
                          "fieldDataType": "",
                          "name": "__result",
                          "signal": ""
                        }
                      }
                    ],
                    "signal": "metrics",
                    "source": ""
                  }
                }
              }
            }
          ]
        }
      },

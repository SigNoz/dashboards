  "spec": {
    "display": {
      "name": "MCP Server",
      "description": "Tool-call volume, latency and errors for any MCP server that emits OpenTelemetry spans following the MCP semantic conventions (for example the official MCP Python SDK 2.x, which does this by default). Pick the server with $service_name."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "service_name",
            "description": "The MCP server service (service.name)"
          },
          "allowAllValue": false,
          "allowMultiple": false,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "none",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          },
          "name": "service_name"
        }
      }
    ],
    "panels": {
      "8daca8a5-d985-4ecf-81d8-a1b8ce6e168f": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "MCP Spans Error Rate",
            "description": "Percentage of MCP spans (mcp.method.name exists) that ended in an error."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "traces",
                          "source": "",
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "service.name = $service_name AND has_error = true AND mcp.method.name EXISTS"
                          },
                          "groupBy": [],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": ""
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "traces",
                          "source": "",
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "service.name = $service_name AND has_error = false AND mcp.method.name EXISTS"
                          },
                          "groupBy": [],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": ""
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "A / (A + B)",
                          "disabled": false,
                          "having": {
                            "expression": ""
                          },
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },

      "cpu-cores-total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU Cores Used",
            "description": "Rate of container.cpu.usage.total in CPU seconds per second, so 1.0 means the container consumes one full core. The receiver truncates this counter to whole seconds, so an idle container produces a spiky line that steps by 1/step_interval. Read CPU Percent for fine-grained CPU load."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": { "legend": { "position": "bottom" } }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "name": "A",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "container.cpu.usage.total",
                        "temporality": "cumulative",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "groupBy": [
                      { "name": "container.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" },
                      { "name": "host.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" }
                    ],
                    "legend": "{{container.name}} @ {{host.name}}",
                    "filter": {

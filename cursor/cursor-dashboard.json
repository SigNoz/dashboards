    "panels": {
      "kpi-input-tokens": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Total input tokens. Filtered to afterAgentResponse to avoid double-counting against the Stop span.",
            "name": "Input Tokens"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "0",
                "unit": ""
              },
              "thresholds": null,
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "aggregations": [
                      {
                        "expression": "sum(gen_ai.usage.input_tokens)"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name = 'ide-agent' AND gen_ai.client.hook.event = 'afterAgentResponse' AND gen_ai.client.name IN $agent AND vcs.repository.name IN $repo AND gen_ai.request.model IN $model"
                    },
                    "legend": "",
                    "limit": 100,
                    "name": "A",
                    "order": [
                      {
                        "direction": "desc",
                        "key": {
                          "fieldContext": "",
                          "fieldDataType": "",
                          "name": "sum(gen_ai.usage.input_tokens)",
                          "signal": ""
                        }
                      }
                    ],
                    "signal": "traces",
                    "source": ""
                  }
                }
              }
            }
          ]
        }
      },

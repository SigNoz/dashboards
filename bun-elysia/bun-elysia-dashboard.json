                    "signal": "metrics",
                    "name": "A",
                    "aggregations": [
                      {
                        "metricName": "http.server.request.duration.count",
                        "temporality": "cumulative",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "service.name IN $service_name AND deployment.environment.name IN $environment AND http.response.status_code >= 400 AND http.response.status_code < 500"
                    },
                    "order": [
                      {
                        "key": {
                          "name": "sum(rate(http.server.request.duration.count))"
                        },
                        "direction": "desc"
                      }
                    ],
                    "limit": 100,
                    "groupBy": [
                      {
                        "name": "http.response.status_code",
                        "fieldContext": "attribute",
                        "fieldDataType": "number",
                        "signal": "metrics"
                      }
                    ],
                    "legend": "{{http.response.status_code}}"
                  }
                }
              }
            }
          ]
        }
      },
      "errors-by-route": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Errors by Route",
            "description": "Error spans per second for each route (from traces)"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "formatting": {
                "unit": "reqps"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "traces",
                    "name": "A",
                    "aggregations": [
                      {
                        "expression": "rate()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name IN $service_name AND deployment.environment.name IN $environment AND http.route IN $http_route AND http.route EXISTS AND has_error = true"
                    },
                    "order": [
                      {
                        "key": {
                          "name": "rate()"
                        },
                        "direction": "desc"
                      }
                    ],
                    "limit": 100,
                    "groupBy": [
                      {
                        "name": "http.route",
                        "fieldContext": "attribute",
                        "fieldDataType": "string",
                        "signal": "traces"
                      }
                    ],
                    "legend": "{{http.route}}"
                  }
                }
              }
            }
          ]
        }

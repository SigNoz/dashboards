{
  "spec": {
    "display": {
      "name": "AISIX AI Gateway Overview",
      "description": "Operational overview for AISIX AI Gateway metrics exported through the Prometheus endpoint and ingested by SigNoz."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "environment",
            "description": "Deployment environment"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "environment",
              "signal": "metrics"
            }
          },
          "name": "environment"
        }
      }
    ],
    "panels": {
      "cache-outcomes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Cache Outcomes",
            "description": "AISIX semantic-cache request rate grouped by cache outcome; no data is expected when cache is disabled."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "aisix_cache_requests_total",
                              "temporality": "cumulative",
                              "timeAggregation": "rate",
                              "spaceAggregation": "sum",
                              "reduceTo": ""
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": "environment IN $environment"
                          },
                          "groupBy": [
                            {
                              "name": "outcome",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "selectFields": [],
                          "having": {
                            "expression": ""
                          },
                          "secondaryAggregations": null,
                          "functions": [],
                          "legend": "{{outcome}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },

{
  "schemaVersion": "v6",
  "image": "",
  "generateName": true,
  "tags": [
    { "key": "tag", "value": "container" },
    { "key": "tag", "value": "podman" },
    { "key": "signal", "value": "metrics" },
    { "key": "receiver", "value": "podmanreceiver" }
  ],
  "spec": {
    "display": {
      "name": "Container Metrics (Podman)",
      "description": "Podman container CPU, memory, network, and block I/O from the OpenTelemetry Collector podman_stats receiver. Every panel filters on container.runtime = 'podman', so the dashboard stays correct on hosts that also run Docker. Use the host.name and container.name variables to narrow the view. The receiver reports only running containers, so a container that stops disappears from these panels."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "host.name",
          "display": {
            "name": "host.name",
            "description": "Host running the Podman containers"
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": { "name": "host.name", "signal": "metrics" }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "container.name",
          "display": {
            "name": "container.name",
            "description": "Podman container name"
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": { "name": "container.name", "signal": "metrics" }
          }
        }
      }
    ],
    "links": [],
    "panels": {
      "containers-running": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Containers Reporting",
            "description": "Number of Podman containers reporting stats. The receiver only reports running containers."
          },
          "links": [],
          "plugin": { "kind": "signoz/NumberPanel", "spec": {} },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "name": "A",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "container.cpu.percent",
                        "temporality": "unspecified",
                        "timeAggregation": "latest",
                        "spaceAggregation": "count",
                        "reduceTo": "last"
                      }
                    ],
                    "filter": {
                      "expression": "container.runtime = 'podman' AND host.name IN $host.name AND container.name IN $container.name"
                    },
                    "order": [
                      { "key": { "name": "count(latest(container.cpu.percent))" }, "direction": "desc" }
                    ],
                    "limit": 100
                  }
                }
              }
            }
          ]
        }
      },
      "avg-cpu-percent": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Avg CPU %",
            "description": "Average container.cpu.percent across the selected containers."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": { "formatting": { "unit": "percent", "decimalPrecision": "2" } }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "name": "A",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "container.cpu.percent",
                        "temporality": "unspecified",
                        "timeAggregation": "avg",
                        "spaceAggregation": "avg",
                        "reduceTo": "avg"
                      }
                    ],
                    "filter": {
                      "expression": "container.runtime = 'podman' AND host.name IN $host.name AND container.name IN $container.name"
                    },
                    "order": [
                      { "key": { "name": "avg(avg(container.cpu.percent))" }, "direction": "desc" }
                    ],
                    "limit": 100
                  }
                }
              }
            }
          ]
        }
      },

            "name": "Agents",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "columnUnits": {
                  "A.p95(duration_nano)": "ns"
                },
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "aggregations": [
                      {
                        "expression": "count()",
                        "alias": "Requests"
                      },
                      {
                        "expression": "p95(duration_nano)",
                        "alias": "Duration"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name in $service_name agent.id EXISTS AND name = 'POST 127.0.0.1/agents/a2a'"
                    },
                    "groupBy": [
                      {
                        "name": "agent.id",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": []

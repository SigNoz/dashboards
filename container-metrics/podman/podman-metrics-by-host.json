        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memory Usage vs Limit",
            "description": "container.memory.usage.total plotted against container.memory.usage.limit on a log scale, since an unlimited container's limit line sits three orders of magnitude above its usage. When a container has no explicit limit, the limit line reports the host's total memory."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "legend": { "position": "bottom" },
              "formatting": { "unit": "bytes" },

      "container-inventory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Containers",
            "description": "One row per container: host, image, average CPU %, average memory %, and last memory usage."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "formatting": {
                "columnUnits": { "A": "percent", "B": "percent", "C": "bytes" },
                "decimalPrecision": "3"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "container_inventory",
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "signal": "metrics",
                          "name": "A",
                          "stepInterval": 60,
                          "legend": "CPU %",
                          "aggregations": [
                            {
                              "metricName": "container.cpu.percent",
                              "temporality": "unspecified",
                              "timeAggregation": "avg",
                              "spaceAggregation": "avg",
                              "reduceTo": "avg"
                            }
                          ],
                          "groupBy": [
                            { "name": "container.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" },
                            { "name": "host.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" },
                            { "name": "container.image.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" }
                          ],
                          "filter": {
                            "expression": "container.runtime = 'podman' AND host.name IN $host.name AND container.name IN $container.name"
                          },
                          "order": [
                            { "key": { "name": "avg(avg(container.cpu.percent))" }, "direction": "desc" }
                          ],
                          "limit": 100
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "signal": "metrics",
                          "name": "B",
                          "stepInterval": 60,
                          "legend": "Memory %",
                          "aggregations": [
                            {
                              "metricName": "container.memory.percent",
                              "temporality": "unspecified",
                              "timeAggregation": "avg",
                              "spaceAggregation": "avg",
                              "reduceTo": "avg"
                            }
                          ],
                          "groupBy": [
                            { "name": "container.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" },
                            { "name": "host.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" },
                            { "name": "container.image.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" }
                          ],
                          "filter": {
                            "expression": "container.runtime = 'podman' AND host.name IN $host.name AND container.name IN $container.name"
                          },
                          "order": [
                            { "key": { "name": "avg(avg(container.memory.percent))" }, "direction": "desc" }
                          ],
                          "limit": 100
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "signal": "metrics",
                          "name": "C",
                          "stepInterval": 60,
                          "legend": "Memory Used",
                          "aggregations": [
                            {
                              "metricName": "container.memory.usage.total",
                              "temporality": "cumulative",
                              "timeAggregation": "avg",
                              "spaceAggregation": "sum",
                              "reduceTo": "last"
                            }
                          ],
                          "groupBy": [
                            { "name": "container.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" },
                            { "name": "host.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" },
                            { "name": "container.image.name", "fieldContext": "resource", "fieldDataType": "string", "signal": "metrics" }
                          ],
                          "filter": {
                            "expression": "container.runtime = 'podman' AND host.name IN $host.name AND container.name IN $container.name"
                          },
                          "order": [
                            { "key": { "name": "sum(avg(container.memory.usage.total))" }, "direction": "desc" }
                          ],
                          "limit": 100
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "cpu-percent": {
